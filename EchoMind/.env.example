# Copy to .env and supply your own values. Never commit the filled .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=your-model-id
# Optional compatible provider endpoint:
ANTHROPIC_BASE_URL=
APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Local processes; Compose overrides container service addresses.
REDIS_URL=redis://:replace-with-a-strong-password@localhost:6379/0
REDIS_PASSWORD=replace-with-a-strong-password
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma
ECHOMIND_ALLOW_LOCAL_CHROMA_FALLBACK=false

ECHOMIND_AUTH_REQUIRED=true
# Public signup creates customer accounts only. Disable with false.
ECHOMIND_REGISTRATION_ENABLED=true
# Existing merchant organization ID; empty uses the isolated self-service workspace.
ECHOMIND_REGISTRATION_ORGANIZATION_ID=
# Optional dedicated /metrics Bearer credential for a local process; keep empty
# unless supplying it privately. This credential cannot access other admin APIs.
ECHOMIND_METRICS_TOKEN=
# Optional UTF-8 secret file; takes precedence over ECHOMIND_METRICS_TOKEN.
# Compose supplies /run/secrets/metrics_token from the ignored .secrets directory.
ECHOMIND_METRICS_TOKEN_FILE=
ECHOMIND_BUSINESS_DB_PATH=./data/business/echomind.sqlite3
ECHOMIND_CONFIRMATION_TTL=900
# Optional Feishu Base outbox, disabled until all fields and table access are configured.
# One organization per table; use /auth/me to obtain the intended merchant organization ID.
ECHOMIND_FEISHU_ENABLED=false
ECHOMIND_FEISHU_ORGANIZATION_ID=
ECHOMIND_FEISHU_APP_ID=
ECHOMIND_FEISHU_APP_SECRET=
ECHOMIND_FEISHU_APP_TOKEN=
ECHOMIND_FEISHU_TABLE_ID=
# Set true behind HTTPS, false only for local HTTP demos.
ECHOMIND_SECURE_COOKIES=false
# Explicit browser origins; include public HTTPS origin when using TLS termination.
ECHOMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174
ECHOMIND_MAX_CONCURRENT_CHATS=8
ECHOMIND_CHAT_TIMEOUT=180
ECHOMIND_SKILLS_DIR=./skills
EVAL_BASELINE_PATH=./data/eval/baseline.json
MONITOR_INTERVAL=10
PROMETHEUS_PORT=0
